# Ficheros que se ejecutan o se sirven en Linux (Dinahosting): siempre LF.
# Con core.autocrlf=true Windows los deja en CRLF y fallan en el servidor
# (p. ej. bash: "invalid option name: set: pipefail").
scripts/deploy/* text eol=lf
scripts/dinahosting/* text eol=lf
scripts/package-dinahosting.mjs text eol=lf
# VPS de Clouding (Debian): scripts y unidades systemd, siempre LF.
scripts/clouding/* text eol=lf
scripts/clouding/systemd/* text eol=lf
