DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

MOTOGP_API_URL="https://api.motogp.pulselive.com/motogp/v1"

MOTOGP_RESULTS_API_URL="https://api.motogp.pulselive.com/motogp/v1/results"

# --- Cuentas de usuario (apagadas por defecto) ---
# Pon REGISTRO_ABIERTO="true" para activar /acceso, /registro, /recuperar, /perfil y la API de cuentas.
REGISTRO_ABIERTO="false"
# Dirección pública de la web (con https en producción). Debe coincidir con la que ve el navegador.
BETTER_AUTH_URL="http://localhost:3000"
# Secreto largo y aleatorio (p. ej. `openssl rand -base64 32`). Obligatorio en producción; nunca en el repositorio.
BETTER_AUTH_SECRET=""
# Correo saliente. Sin SMTP_HOST, en desarrollo los correos salen por la consola; en producción dan error.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Rebufo <no-responder@tudominio.es>"
