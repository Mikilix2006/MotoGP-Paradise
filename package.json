{
  "name": "rebufo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "start:web": "prisma migrate deploy && next start",
    "lint": "eslint .",
    "import:seasons": "tsx scripts/import-seasons.ts",
    "import:events": "tsx scripts/import-events.ts",
    "import:event-categories": "tsx scripts/import-event-categories.ts",
    "import:sessions": "tsx scripts/import-sessions.ts",
    "import:event-details": "tsx scripts/import-event-details.ts",
    "import:session-results": "tsx scripts/import-session-results.ts",
    "import:riders": "tsx scripts/import-riders.ts",
    "import:rider-statistics": "tsx scripts/import-rider-statistics.ts",
    "import:championship-standings": "tsx scripts/import-championship-standings.ts",
    "import:bmw-award": "tsx scripts/import-bmw-award.ts",
    "fix:duplicate-riders": "tsx scripts/merge-duplicate-riders.ts",
    "sync:sessions": "tsx scripts/watch-sessions.ts --once",
    "watch:sessions": "tsx scripts/watch-sessions.ts",
    "package:dinahosting": "node scripts/package-dinahosting.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test --project=chromium-escritorio --project=webkit-iphone",
    "test:api": "playwright test --project=api",
    "test:all": "npm run lint && npm run typecheck && npm test && playwright test"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "better-auth": "^1.7.18",
    "lucide-react": "^0.468.0",
    "next": "^16.3.3",
    "nodemailer": "^10.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "jsdom": "^31.0.0",
    "postcss": "^8.4.0",
    "prisma": "^6.12.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.23.13",
    "typescript": "^5.0.0",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "msgpackr-extract@3.0.4": true,
    "workerd@1.20260704.1": true,
    "@prisma/engines@6.12.0": true,
    "prisma@6.12.0": true,
    "@prisma/client@6.12.0": true
  }
