# Lanza motogp-sync.service cada 5 minutos en punto (:00, :05, :10...).
# OnCalendar no depende de ninguna activacion anterior: si la primera pasada se omitio
# (ConditionPathExists, antes del primer despliegue), el temporizador sigue disparandose.
# Si una pasada sigue viva cuando toca la siguiente, la nueva sale con codigo 0: el
# bundle detecta su propio bloqueo (tmp/sync-sessions.lock) y, al ser el servicio
# oneshot, systemd no lo relanza ni acumula pasadas.
[Unit]
Description=MotoGP Stats - sincronización de sesiones cada 5 minutos

[Timer]
OnCalendar=*:0/5
AccuracySec=30s
Unit=motogp-sync.service

[Install]
WantedBy=timers.target
